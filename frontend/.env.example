# Copy to .env.local for local dev, or set as a build-time env var in Vercel.

# Backend API base URL. Relative "/api" works via the Vite dev proxy; the
# packaged Android app and the deployed site need the real backend origin
# with "/api" included, e.g. https://arecanut-backend.vercel.app/api
VITE_API_BASE=/api

# OpenPanel (openpanel.dev) product analytics client ID. Safe to be public —
# it's not a secret like a clientSecret, just identifies which OpenPanel
# project events get sent to. Leave blank to disable analytics entirely
# (src/lib/analytics.ts no-ops when this is unset).
VITE_OPENPANEL_CLIENT_ID=
