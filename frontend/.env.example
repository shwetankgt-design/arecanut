# Copy to .env.local for local dev, or set as a build-time env var in Vercel.

# Backend API base URL. Relative "/api" works via the Vite dev proxy; the
# packaged Android app and the deployed site need the real backend origin
# with "/api" included, e.g. https://arecanut-backend.vercel.app/api
VITE_API_BASE=/api

# Google Maps JavaScript API key, used by the "Draw on Map" plot-boundary
# capture tab. Until this is set, that tab shows a graceful "not configured"
# message and the other two capture methods (Excel upload, GPS walk) still
# work normally. Needs the Maps JavaScript API enabled + billing on the
# associated Google Cloud project.
VITE_GOOGLE_MAPS_API_KEY=
